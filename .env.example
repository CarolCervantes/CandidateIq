# ========================================================
# CANDIDATEIQ - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ========================================================
# Este archivo contiene las credenciales para el envío de Email y WhatsApp.
# Al desplegar en Vercel / Render / Railway, añade estas variables en su panel de control.

PORT=3000

# ----- CONFIGURACIÓN DE CORREO (SMTP / Nodemailer) -----
# Puedes usar Gmail, Outlook, Amazon SES, SendGrid, Mailgun o cualquier servidor SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_o_api_key
EMAIL_FROM="CandidateIQ Selección <tu_correo@gmail.com>"

# ----- CONFIGURACIÓN DE WHATSAPP (Twilio API) -----
# Crea una cuenta en Twilio (https://www.twilio.com) y activa WhatsApp Sandbox o tu número verificado.
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# ----- API KEY / CLAVE DE SEGURIDAD (Opcional) -----
# Si deseas proteger el servidor MCP / API de accesos no autorizados:
CANDIDATEIQ_API_KEY=candidateiq_secret_key_123
